{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  
  // JavaScript/Node.js settings
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": true
    }
  },
  
  // JSON settings
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  
  // Markdown settings
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": false
  },
  
  // Shell script settings
  "[shellscript]": {
    "editor.tabSize": 2,
    "files.eol": "\n"
  },
  
  // YAML settings (for docker-compose files)
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  
  // Docker file settings
  "[dockerfile]": {
    "editor.tabSize": 2
  },
  
  // ESLint settings
  "eslint.enable": true,
  "eslint.validate": [
    "javascript"
  ],
  "eslint.workingDirectories": [
    "manager/server",
    "manager/client"
  ],
  
  // File exclusions for better performance
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/build": true
  },
  
  // Search exclusions
  "search.exclude": {
    "**/node_modules": true,
    "**/build": true,
    "**/.git": true
  },
  
  // File associations
  "files.associations": {
    "*.conf": "properties",
    "Dockerfile*": "dockerfile",
    "docker-compose*.yml": "yaml"
  }
}
